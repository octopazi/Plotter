{
    "name": "MyFormat_v1",

    "separator": ",",
    "ignore_prefix": "#",
    "header_lines": 1,

    "columns": {
        "x": {
            "type": "column",      // "column" or "index"
            "index": 0             // only used if type="column"
        },
        "y": [
            {
                "name": "Voltage",
                "index": 1
            },
            {
                "name": "Current",
                "index": 2
            }
        ]
    },

    "conversions": [
        {
            "name": "Voltage_mV",
            "formula": "col1 * 1000",
            "output_index": 3
        },
        {
            "name": "Derived",
            "formula": "(col2 - col1) / 50",
            "output_index": 4
        }
    ]
}